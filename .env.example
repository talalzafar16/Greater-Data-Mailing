# Copy to `.env.local`. Both values are baked in at build time: redeploy after changing either.

# Production origin, no trailing slash: https://www.greaterdata.com (also the built-in fallback).
# Leave unset on Vercel preview deploys so previews don't emit production canonical URLs.
NEXT_PUBLIC_SITE_URL=

# Web3Forms key for the /contact form (https://web3forms.com). Register with sl@greaterdata.com.
# Public by design (in the client bundle); set allowed domains in the Web3Forms dashboard.
NEXT_PUBLIC_WEB3FORMS_KEY=
