{
  "name": "greater-data-mailing",
  "version": "0.1.0",
  "private": true,
  "_comment": "Scripts call package entrypoints through `node` instead of the `.bin` shims: this directory name contains an `&`, which npm's generated .cmd shim expands unquoted and cmd.exe then treats as a command separator. Plain `next dev` fails here. Renaming the folder would let the shims work again.",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "typegen": "node node_modules/next/dist/bin/next typegen",
    "typecheck": "npm run typegen && node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
